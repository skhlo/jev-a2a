# `router serve` as a systemd user service. ExecStart expects the wrapper
# ~/.local/bin/router from the README's quick start. Install steps, logs and
# the exit codes: docs/operating.md.
[Unit]
Description=Jev router: replies over HTTP and the board

[Service]
ExecStart=%h/.local/bin/router serve
# The user manager's PATH is not the shell's; name where node comes from.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/bin
Restart=on-failure
RestartSec=5
# Exit 2 is a reason that a restart cannot change: the port is taken, the
# configuration is invalid or ROUTER_TOKEN is not set. It stays down with
# the message in `systemctl --user status`. Exit 75 (address not up yet)
# restarts.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
