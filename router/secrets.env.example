# Copy to ~/.config/jev-router/secrets.env (mode 600) and fill in.
# The router reads this file at start; the shell environment overrides it.
# Router host: the key for Jev.
TYPESAFE_API_KEY=
# Router host and every host with a participant: the shared secret
# `router serve` requires and `router` on a host without a configuration
# presents.
ROUTER_TOKEN=
# A host that does not run the router: where `router serve` listens, as an
# http:// URL.
ROUTER_URL=
# Optional, with a `usage` section. What each reads, and where an account
# reads without one, is in docs/operating.md (Usage).
# OPENROUTER_MANAGEMENT_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
