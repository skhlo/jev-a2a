# Copy to ~/.config/jev-router/secrets.env (mode 600) and fill in.
# The router reads this file at start; the shell environment overrides it.
# Router host: the key for Jev.
TYPESAFE_API_KEY=
# Router host and every host that replies: the shared secret `router serve`
# requires and the reply client presents.
ROUTER_TOKEN=
# A host that only replies: where `router serve` listens, as an http:// URL.
ROUTER_URL=
