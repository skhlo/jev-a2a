# Copy to ~/.config/jev-router/secrets.env (mode 600) and fill in.
# The router reads this file at start; the shell environment overrides it.
# Router host: the key for Jev.
TYPESAFE_API_KEY=
# Router host and every host with a participant: the shared secret
# `router serve` requires and the client presents.
ROUTER_TOKEN=
# A host that does not run the router: where `router serve` listens, as an
# http:// URL.
ROUTER_URL=
# Optional, with a `usage` section: OpenRouter's account balance and
# spending; the API keys when Pi's ~/.pi/agent/auth.json does not hold
# them; a Claude token in place of Claude Code's own login on this host.
# OPENROUTER_MANAGEMENT_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# ROUTER_CLAUDE_OAUTH_TOKEN=
